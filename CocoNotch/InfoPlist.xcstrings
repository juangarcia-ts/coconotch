            "state": "translated",
            "value": "CocoNotch는 현재 위치의 날씨를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CocoNotch mostra o tempo onde você está."
          }
        },
        "zh-Hans": {
