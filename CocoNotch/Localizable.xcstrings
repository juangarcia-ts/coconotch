    "Copies made in these apps aren't saved. Password managers that mark their copies are always skipped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien aus diesen Apps werden nicht gespeichert. Passwortmanager, die ihre Kopien kennzeichnen, werden immer übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que copies en estas apps no se guarda. Los gestores de contraseñas que marcan sus copias siempre se omiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies faites dans ces apps ne sont pas enregistrées. Les gestionnaires de mots de passe qui marquent leurs copies sont toujours ignorés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie fatte in queste app non vengono salvate. I gestori di password che contrassegnano le loro copie vengono sempre ignorati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリでのコピーは保存されません。コピーにマークを付けるパスワードマネージャは常に除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에서 복사한 내용은 저장되지 않습니다. 복사본에 표시를 하는 암호 관리자는 항상 건너뜁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias feitas nesses apps não são salvas. Gerenciadores de senhas que marcam suas cópias são sempre ignorados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这些应用中拷贝的内容不会被保存。会标记其拷贝内容的密码管理器总会被跳过。"
          }
        }
      }
    },
