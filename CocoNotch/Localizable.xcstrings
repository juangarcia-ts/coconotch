    "Videos can't be converted together with images or PDFs. Clear and drop them separately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos lassen sich nicht zusammen mit Bildern oder PDFs konvertieren. Leere die Liste und lege sie getrennt ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los videos no se pueden convertir junto con imágenes o PDF. Vacía y suéltalos por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos ne peuvent pas être converties avec des images ou des PDF. Videz puis déposez-les séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I video non si possono convertire insieme a immagini o PDF. Svuota e rilasciali separatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオは画像や PDF と一緒に変換できません。空にしてから別々にドロップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오는 이미지나 PDF와 함께 변환할 수 없습니다. 비운 다음 따로 놓으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos não podem ser convertidos junto com imagens ou PDFs. Limpe e solte-os separadamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频不能与图像或 PDF 一起转换。请清空后分别拖放。"
          }
        }
      }
