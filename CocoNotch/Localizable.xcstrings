    "CocoNotch can't read your calendars. You can allow it in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch kann deine Kalender nicht lesen. Du kannst es in den Systemeinstellungen erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch no puede leer tus calendarios. Puedes permitirlo en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch ne peut pas lire vos calendriers. Vous pouvez l'autoriser dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch non può leggere i tuoi calendari. Puoi consentirlo in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch はカレンダーを読み取れません。システム設定で許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch가 캘린더를 읽을 수 없습니다. 시스템 설정에서 허용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CocoNotch não pode ler seus calendários. Você pode permitir isso nos Ajustes do Sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch 无法读取你的日历。你可以在系统设置中允许。"
          }
        }
      }
    },
    "CocoNotch can't use the camera. You can allow it in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch kann die Kamera nicht verwenden. Du kannst es in den Systemeinstellungen erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch no puede usar la cámara. Puedes permitirlo en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch ne peut pas utiliser la caméra. Vous pouvez l'autoriser dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch non può usare la fotocamera. Puoi consentirlo in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch はカメラを使用できません。システム設定で許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch가 카메라를 사용할 수 없습니다. 시스템 설정에서 허용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CocoNotch não pode usar a câmera. Você pode permitir isso nos Ajustes do Sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch 无法使用相机。你可以在系统设置中允许。"
          }
        }
      }
    },
    "CocoNotch couldn't restart. Quit it from the menu bar and open it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch konnte nicht neu starten. Beende es über die Menüleiste und öffne es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch no pudo reiniciarse. Ciérralo desde la barra de menús y vuelve a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch n'a pas pu redémarrer. Quittez-le depuis la barre des menus et rouvrez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch non è riuscito a riavviarsi. Chiudilo dalla barra dei menu e riaprilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch を再起動できませんでした。メニューバーから終了して、もう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch를 재시작할 수 없습니다. 메뉴 막대에서 종료한 다음 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CocoNotch não conseguiu reiniciar. Encerre-o pela barra de menus e abra-o novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoNotch 无法重新启动。请从菜单栏退出并重新打开。"
          }
        }
      }
    },
    "CocoNotch isn't allowed to control %@.": {
      "localizations": {
