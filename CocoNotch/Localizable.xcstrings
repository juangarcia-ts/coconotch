    "Originals are never replaced; a taken name gets a number, like Finder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale werden nie ersetzt; ein vergebener Name bekommt eine Nummer, wie im Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los originales nunca se reemplazan; un nombre ocupado recibe un número, como en el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les originaux ne sont jamais remplacés ; un nom déjà pris reçoit un numéro, comme dans le Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli originali non vengono mai sostituiti; un nome già usato riceve un numero, come nel Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルが置き換えられることはありません。名前が使われている場合は Finder と同様に番号が付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 대체되지 않습니다. 이미 있는 이름에는 Finder처럼 번호가 붙습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os originais nunca são substituídos; um nome já usado recebe um número, como no Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原件绝不会被替换；名称已被占用时会像“访达”一样加上编号。"
          }
        }
      }
    },
