    "This deletes all settings, shelf files, clipboard history and Ask chats, and turns off launch at login.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Einstellungen, Dateien in der Ablage, der Verlauf der Zwischenablage und die Chats in „Fragen“ gelöscht und „Bei der Anmeldung öffnen“ wird ausgeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán todos los ajustes, los archivos del estante, el historial del portapapeles y los chats de Preguntar, y se desactivará abrir al iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les réglages, les fichiers de l'étagère, l'historique du presse-papiers et les conversations de Demander seront supprimés, et l'ouverture à la connexion sera désactivée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati tutte le impostazioni, i file dello scaffale, la cronologia degli appunti e le chat di Chiedi, e l'apertura al login verrà disattivata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定、シェルフのファイル、クリップボードの履歴、「質問」のチャットが削除され、ログイン時の起動がオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정, 선반 파일, 클립보드 기록, 질문 채팅이 삭제되고 로그인 시 실행이 꺼집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga todos os ajustes, os arquivos da estante, o histórico da área de transferência e as conversas do Perguntar, e desativa abrir ao iniciar sessão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除所有设置、暂存架文件、剪贴板历史和“提问”对话，并关闭登录时启动。"
          }
        }
      }
    },
