          "stringUnit": {
            "state": "translated",
            "value": "Les discussions sont enregistrées uniquement sur ce Mac. Une limite plus basse s'applique dès la prochaine discussion enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat vengono salvate solo su questo Mac. Un limite più basso vale dalla prossima chat salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットはこの Mac にのみ保存されます。小さい上限は次に保存するチャットから適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화는 이 Mac에만 저장됩니다. 더 작은 한도는 다음에 저장되는 대화부터 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os chats ficam salvos só neste Mac. Um limite menor vale a partir do próximo chat salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天仅保存在这台 Mac 上。更小的上限从下一个保存的聊天开始生效。"
          }
        }
      }
    },
