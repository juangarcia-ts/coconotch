    "Looks up the song's title and artist on LRCLIB. Timed lyrics follow along; click a line to play from there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht Titel und Interpret des Songs auf LRCLIB. Synchronisierte Songtexte laufen mit; klicke auf eine Zeile, um ab dort abzuspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca el título y el artista de la canción en LRCLIB. La letra sincronizada sigue la canción; haz clic en una línea para reproducir desde ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche le titre et l'artiste du morceau sur LRCLIB. Les paroles synchronisées défilent ; cliquez sur une ligne pour lire à partir de là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca titolo e artista del brano su LRCLIB. Il testo sincronizzato segue il brano; fai clic su una riga per riprodurre da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲名とアーティストを LRCLIB で検索します。タイミング付きの歌詞は再生に合わせて進み、行をクリックするとそこから再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LRCLIB에서 노래 제목과 아티스트를 찾습니다. 시간이 맞춰진 가사는 재생을 따라가며, 한 줄을 클릭하면 그 부분부터 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca o título e o artista da música no LRCLIB. A letra sincronizada acompanha a música; clique em uma linha para tocar a partir dali."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 LRCLIB 上查找歌曲名称和艺人。同步歌词会随播放滚动；点按一行即可从那里播放。"
          }
        }
      }
    },
