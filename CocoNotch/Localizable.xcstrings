    "Privacy permissions stay as they are; change them in System Settings → Privacy & Security.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutzberechtigungen bleiben unverändert; ändere sie unter Systemeinstellungen → Datenschutz & Sicherheit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los permisos de privacidad no cambian; modifícalos en Ajustes del Sistema → Privacidad y seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations de confidentialité restent inchangées ; modifiez-les dans Réglages Système → Confidentialité et sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I permessi della privacy restano invariati; modificali in Impostazioni di Sistema → Privacy e sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーの許可はそのままです。変更するにはシステム設定 →「プライバシーとセキュリティ」を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 권한은 그대로 유지됩니다. 시스템 설정 → 개인정보 보호 및 보안에서 변경하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As permissões de privacidade continuam como estão; altere-as em Ajustes do Sistema → Privacidade e Segurança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私权限保持不变；可在“系统设置”→“隐私与安全性”中更改。"
          }
        }
      }
    },
