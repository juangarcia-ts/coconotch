    "Keep copies the video into the new format without re-encoding, so it's quick and lossless.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beibehalten kopiert das Video ohne Neucodierung ins neue Format, also schnell und verlustfrei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener copia el video al nuevo formato sin recodificarlo, así que es rápido y sin pérdida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver copie la vidéo dans le nouveau format sans la réencoder : c'est rapide et sans perte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni copia il video nel nuovo formato senza ricodificarlo, quindi è rapido e senza perdita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「そのまま」は再エンコードせずにビデオを新しい形式にコピーするため、高速で劣化もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지는 비디오를 다시 인코딩하지 않고 새 형식으로 복사하므로 빠르고 손실이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter copia o vídeo para o novo formato sem recodificar, então é rápido e sem perdas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“保留”会在不重新编码的情况下把视频拷贝为新格式，因此快速且无损。"
          }
        }
      }
    },
