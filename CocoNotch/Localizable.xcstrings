          "stringUnit": {
            "state": "translated",
            "value": "Trascina per guardare avanti o indietro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして先や前の時刻を確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그해 앞이나 뒤의 시간 확인"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para ver adiante ou para trás"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以查看之前或之后的时间"
          }
        }
      }
    },
    "Drag to reorder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sortieren ziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서 변경"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序"
          }
        }
      }
    },
    "Drag to reorder. Double-click a name or use ✎ to give it an alias. Your current time zone follows your Mac when you travel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sortieren ziehen. Doppelklicke auf einen Namen oder nutze ✎ für einen Alias. Deine aktuelle Zeitzone folgt deinem Mac auf Reisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Haz doble clic en un nombre o usa ✎ para darle un alias. Tu zona horaria actual sigue a tu Mac cuando viajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Double-cliquez sur un nom ou utilisez ✎ pour lui donner un alias. Votre fuseau horaire actuel suit votre Mac en voyage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Fai doppio clic su un nome o usa ✎ per dargli un alias. Il tuo fuso orario attuale segue il Mac quando viaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。名前をダブルクリックするか ✎ を使って別名を付けられます。現在のタイムゾーンは、移動すると Mac に合わせて変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 바꿉니다. 이름을 이중 클릭하거나 ✎를 사용해 별칭을 지정하세요. 여행 중에는 현재 시간대가 Mac을 따라 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Clique duas vezes em um nome ou use ✎ para dar um apelido. Seu fuso horário atual acompanha o Mac quando você viaja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序。连按名称或使用 ✎ 设置别名。你出行时，当前时区会跟随 Mac 变化。"
          }
        }
      }
    },
    "Drag to reorder. The notch shows the widgets that are on, in this order.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sortieren ziehen. Die Notch zeigt die aktiven Widgets in dieser Reihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. El notch muestra los widgets activados en este orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. L'encoche affiche les widgets activés dans cet ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Il notch mostra i widget attivi in quest'ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。ノッチにはオンのウィジェットがこの順で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 바꿉니다. 노치는 켜진 위젯을 이 순서로 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. O notch mostra os widgets ativados nesta ordem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序。刘海会按此顺序显示已打开的小组件。"
          }
        }
      }
    },
