    "%@ can't be found right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist gerade nicht auffindbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encuentra %@ en este momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est introuvable pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento %@ non si trova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 %@을(를) 찾을 수 없습니다."
          }
        },
