    "Drag a timeline to look ahead or back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh an einer Zeitleiste, um vor- oder zurückzublicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una línea de tiempo para mirar adelante o atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une frise pour avancer ou reculer dans le temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina una linea temporale per guardare avanti o indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムラインをドラッグして先や前の時刻を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임라인을 드래그해 앞이나 뒤의 시간을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma linha do tempo para ver mais adiante ou para trás."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动时间轴即可查看之前或之后的时间。"
          }
        }
      }
    },
