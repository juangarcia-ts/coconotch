    "Open the Meetings tab in the notch and allow calendar access to choose calendars here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Tab Meetings in der Notch und erlaube den Kalenderzugriff, um hier Kalender auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la pestaña Reuniones en el notch y permite el acceso al calendario para elegir calendarios aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'onglet Réunions dans l'encoche et autorisez l'accès au calendrier pour choisir des calendriers ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la scheda Riunioni nel notch e consenti l'accesso al calendario per scegliere i calendari qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでカレンダーを選ぶには、ノッチのミーティングタブを開いてカレンダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 캘린더를 선택하려면 노치의 회의 탭을 열고 캘린더 접근을 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
