    },
    "Switched-off widgets aren't listed. A shortcut you recorded comes back when you switch its widget on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivierte Widgets werden nicht aufgeführt. Ein aufgenommener Kurzbefehl kehrt zurück, wenn du sein Widget wieder aktivierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los widgets desactivados no aparecen. Un atajo que grabaste vuelve cuando activas su widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets désactivés ne sont pas listés. Un raccourci enregistré revient quand vous réactivez son widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I widget disattivati non sono elencati. Un'abbreviazione registrata torna quando riattivi il suo widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのウィジェットは表示されません。記録したショートカットは、そのウィジェットをオンにすると戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼진 위젯은 목록에 나타나지 않습니다. 기록한 단축키는 위젯을 켜면 다시 돌아옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets desativados não aparecem. Um atalho que você gravou volta quando você ativa o widget dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭的小组件不会列出。你录制的快捷键会在打开对应小组件时恢复。"
          }
        }
      }
    },
