            "state": "translated",
            "value": "Schnelle Antworten, erstellt auf diesem Mac. Nichts verlässt ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuestas rápidas, hechas en este Mac. Nada sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des réponses rapides, produites sur ce Mac. Rien n'en sort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposte rapide, generate su questo Mac. Nulla ne esce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac 上で作られる素早い回答。外部には何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 만드는 빠른 답변. 아무것도 외부로 나가지 않습니다."
          }
        },
        "pt-BR": {
