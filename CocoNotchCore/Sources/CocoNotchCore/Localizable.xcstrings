    "Claude Code isn't signed in on this Mac. Run `claude` and sign in, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist auf diesem Mac nicht angemeldet. Führe `claude` aus, melde dich an und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code no tiene sesión iniciada en este Mac. Ejecuta `claude`, inicia sesión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code n'est pas connecté sur ce Mac. Lancez `claude`, connectez-vous, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code non ha effettuato l'accesso su questo Mac. Esegui `claude`, accedi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac では Claude Code にサインインしていません。`claude` を実行してサインインしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 Claude Code에 로그인되어 있지 않습니다. `claude`를 실행해 로그인한 다음 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
