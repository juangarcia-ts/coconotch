    "Your Claude Code login has expired. Open Claude Code once to refresh it, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Claude-Code-Anmeldung ist abgelaufen. Öffne Claude Code einmal, um sie zu erneuern, und versuch es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de Claude Code caducó. Abre Claude Code una vez para renovarla y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre connexion Claude Code a expiré. Ouvrez Claude Code une fois pour la renouveler, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo accesso a Claude Code è scaduto. Apri Claude Code una volta per rinnovarlo, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code のログインの有効期限が切れました。Claude Code を一度開いて更新してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 로그인이 만료되었습니다. Claude Code를 한 번 열어 갱신한 다음 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu login do Claude Code expirou. Abra o Claude Code uma vez para renová-lo e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Claude Code 登录已过期。请打开一次 Claude Code 以刷新，然后重试。"
          }
        }
      }
    },
    "Your keychain is locked. Unlock your Mac, and usage loads again on its own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlüsselbund ist gesperrt. Entsperre deinen Mac, dann lädt die Nutzung von selbst neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu llavero está bloqueado. Desbloquea tu Mac y el uso volverá a cargarse solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre trousseau est verrouillé. Déverrouillez votre Mac, et l'utilisation se rechargera d'elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo portachiavi è bloccato. Sblocca il Mac e l'utilizzo si ricaricherà da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンがロックされています。Mac のロックを解除すると、使用量が自動的に再読み込みされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인이 잠겨 있습니다. Mac 잠금을 해제하면 사용량이 자동으로 다시 불러와집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas Chaves estão bloqueadas. Desbloqueie o Mac e o uso volta a carregar sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的钥匙串已锁定。解锁 Mac 后，用量会自动重新载入。"
          }
        }
      }
    },
    "Your location couldn't be found. Try again, or search for a city.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort wurde nicht gefunden. Versuch es erneut oder suche nach einer Stadt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo encontrar tu ubicación. Vuelve a intentarlo o busca una ciudad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position est introuvable. Réessayez ou recherchez une ville."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare la tua posizione. Riprova o cerca una città."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地が見つかりませんでした。もう一度試すか、都市を検索してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 찾을 수 없습니다. 다시 시도하거나 도시를 검색하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar sua localização. Tente novamente ou busque uma cidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到你的位置。请重试，或搜索城市。"
          }
        }
      }
    },
