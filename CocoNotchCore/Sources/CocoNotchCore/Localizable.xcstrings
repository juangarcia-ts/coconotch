          }
        }
      }
    },
    "Claude's usage service answered in an unexpected way. It may have changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Nutzungsdienst von Claude hat unerwartet geantwortet. Er hat sich vielleicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de uso de Claude respondió de forma inesperada. Puede que haya cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d'utilisation de Claude a répondu de façon inattendue. Il a peut-être changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio di utilizzo di Claude ha risposto in modo imprevisto. Potrebbe essere cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
