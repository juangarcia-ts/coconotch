    "Apple Intelligence is still downloading. Ask shows up in the notch once it's ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wird noch geladen. Fragen erscheint in der Notch, sobald es bereit ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aún se está descargando. Preguntar aparecerá en el notch cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est encore en cours de téléchargement. Demander apparaîtra dans l'encoche une fois prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è ancora in download. Chiedi appare nel notch quando è pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence はダウンロード中です。準備ができると質問がノッチに表示されます。"
